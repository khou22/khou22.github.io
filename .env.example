# Database Configuration
# Replace with your actual Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/dbname?schema=public

# Contact & Marketing
CONTACT_FORM_ADDRESS=your-email@example.com
MEETING_SCHEDULER_URL=https://calendly.com/your-link
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=phc_XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Stripe Configuration
# Get these from the Stripe Dashboard: https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY is REQUIRED for checkout to work.
# Replace 'sk_test_placeholder' with your actual test secret key.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Email Services
SENDGRID_API_KEY=SG.XXXXXXXXXX
MAILGUN_API_KEY=key-XXXXXXXXXX
MAILGUN_DOMAIN=mg.yourdomain.com
